{
  "name": "@vault-neural-links/desktop-app",
  "version": "0.0.0",
  "private": true,
  "description": "Local-installation desktop shell that replaces Obsidian: OKF folder + the same engine, bundled MCP server as the only AI-facing surface (no chat, no owned API key).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs production",
    "dev": "tsc && node esbuild.config.mjs production && electron .",
    "watch:renderer": "node esbuild.config.mjs",
    "start": "electron ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vault-neural-links/core": "*",
    "@vault-neural-links/render-core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^43.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
